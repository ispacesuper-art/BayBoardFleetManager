# Power Automate HTTP trigger URL (contains a signature — keep this file off git).
# After saving, restart `npm run dev`.
BOOKING_WEBHOOK_URL=
# Optional shared key. In Power Automate, check triggerHeaders['X-Bay-Board-Secret'].
BOOKING_WEBHOOK_SECRET=

# Posted JSON:
# action: created | updated | cancelled
# booking: id, title, bookedBy, startsAt, endsAt, notes, createdAt, cancelledAt
# boxes[]: id, name, callsign, vessel (Box|Case), platform, staffKey (use this as Bookings staff name)
# extras[]: id, kind, name
